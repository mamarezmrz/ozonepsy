DATABASE_URL=postgresql://postgres:password@localhost:5432/ozone?schema=public

# The admin host is used by proxy.ts to isolate the admin panel from the public site.
ADMIN_HOST=admin.example.com
ADMIN_DEV_HOST=admin.localhost:3000
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_IDLE_TTL_SECONDS=1800
ADMIN_LOGIN_RATE_LIMIT_MAX=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
ADMIN_LOGIN_RATE_LIMIT_ENABLED=true

# Public authentication protection.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_DEV_EXPOSE_RESET_TOKEN=false

# Demo checkout is for development/test only and is hard-disabled in production.
DEMO_PAYMENT_ENABLED=true
DEMO_PAYMENT_ALLOWED_ENVIRONMENTS=development,test
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_CONTENT_SOURCE=auto
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
EMAIL_PROVIDER=
EMAIL_FROM=

# Admin-managed media. Local files are stored outside the repository in development.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=../ozone-media
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional, one-time bootstrap for the first SUPER_ADMIN. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
